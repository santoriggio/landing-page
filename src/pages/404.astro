---
import Button from '../components/button.astro';
import Layout from '../components/layout.astro';
---

<Layout title="Pagina non trovata" noindex>
  <section class="section">
    <div class="page-wrap not-found">
      <h1 class="text-h2 text-ink-900">Pagina non trovata</h1>
      <p class="text-body text-ink-700">Questa pagina non esiste o è stata spostata.</p>
      <Button variant="primary" href="/">Torna alla home</Button>
    </div>
  </section>
</Layout>
