---
const features = [
  {
    name: 'Costo prevedibile',
    santoRiggio: true,
    apex: false,
    celestial: true,
  },
  {
    name: 'Continuità di sviluppo',
    santoRiggio: true,
    apex: true,
    celestial: false,
  },
  {
    name: 'Zero lock-in contrattuale',
    santoRiggio: true,
    apex: false,
    celestial: true,
  },
  {
    name: 'Comunicazione diretta',
    santoRiggio: true,
    apex: true,
    celestial: false,
  },
  {
    name: 'Nessun overhead nascosto',
    santoRiggio: true,
    apex: false,
    celestial: false,
  },
];
---

<div class='overflow-x-auto'>
  <table class='w-full border-collapse'>
    <thead>
      <tr class='border-b-2 border-gray-200'>
        <th class='p-4 text-left font-semibold text-gray-700'>Features</th>
        <th class='p-4 text-center bg-green-50'>
          <div class='flex items-center justify-center gap-2'>
            <div class='w-8 h-8 bg-primary rounded-lg flex items-center justify-center'>
              <svg class='w-5 h-5 text-white' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
                ></path>
              </svg>
            </div>
            <span class='font-bold text-gray-900'>Santo Riggio</span>
          </div>
        </th>
        <th class='p-4 text-center bg-gray-50'>
          <div class='flex items-center justify-center gap-2'>
            <div class='w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center'>
              <svg class='w-5 h-5 text-white' fill='currentColor' viewBox='0 0 24 24'>
                <path
                  d='M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5'
                  stroke='currentColor'
                  stroke-width='2'
                  fill='none'></path>
              </svg>
            </div>
            <span class='font-bold text-gray-900'>APEX</span>
          </div>
        </th>
        <th class='p-4 text-center bg-gray-50'>
          <div class='flex items-center justify-center gap-2'>
            <div class='w-8 h-8 bg-red-500 rounded-lg flex items-center justify-center'>
              <svg class='w-5 h-5 text-white' fill='currentColor' viewBox='0 0 24 24'>
                <path
                  d='M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z'
                ></path>
              </svg>
            </div>
            <span class='font-bold text-gray-900'>Celestial</span>
          </div>
        </th>
      </tr>
    </thead>
    <tbody>
      {
        features.map((feature, index) => (
          <tr class={`border-b border-gray-200 ${index % 2 === 0 ? 'bg-white' : 'bg-gray-50'}`}>
            <td class='p-4 text-gray-700 font-medium'>{feature.name}</td>
            <td class='p-4 text-center bg-green-50'>
              {feature.santoRiggio ? (
                <div class='flex justify-center'>
                  <div class='w-6 h-6 rounded-full bg-green-100 flex items-center justify-center'>
                    <svg class='w-4 h-4 text-green-600' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='3'
                        d='M5 13l4 4L19 7'
                      />
                    </svg>
                  </div>
                </div>
              ) : (
                <div class='flex justify-center'>
                  <div class='w-6 h-6 rounded-full bg-red-100 flex items-center justify-center'>
                    <svg class='w-4 h-4 text-red-600' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='3'
                        d='M6 18L18 6M6 6l12 12'
                      />
                    </svg>
                  </div>
                </div>
              )}
            </td>
            <td class='p-4 text-center'>
              {feature.apex ? (
                <div class='flex justify-center'>
                  <div class='w-6 h-6 rounded-full bg-green-100 flex items-center justify-center'>
                    <svg class='w-4 h-4 text-green-600' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='3'
                        d='M5 13l4 4L19 7'
                      />
                    </svg>
                  </div>
                </div>
              ) : (
                <div class='flex justify-center'>
                  <div class='w-6 h-6 rounded-full bg-red-100 flex items-center justify-center'>
                    <svg class='w-4 h-4 text-red-600' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='3'
                        d='M6 18L18 6M6 6l12 12'
                      />
                    </svg>
                  </div>
                </div>
              )}
            </td>
            <td class='p-4 text-center'>
              {feature.celestial ? (
                <div class='flex justify-center'>
                  <div class='w-6 h-6 rounded-full bg-green-100 flex items-center justify-center'>
                    <svg class='w-4 h-4 text-green-600' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='3'
                        d='M5 13l4 4L19 7'
                      />
                    </svg>
                  </div>
                </div>
              ) : (
                <div class='flex justify-center'>
                  <div class='w-6 h-6 rounded-full bg-red-100 flex items-center justify-center'>
                    <svg class='w-4 h-4 text-red-600' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='3'
                        d='M6 18L18 6M6 6l12 12'
                      />
                    </svg>
                  </div>
                </div>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <div class='flex gap-4 justify-center items-center mt-8'>
    <button
      class='bg-primary hover:bg-primary-dark text-white font-semibold px-8 py-3 rounded-lg transition-colors'>
      Scopri
    </button>
    <button class='text-primary hover:text-primary-dark font-semibold px-8 py-3 transition-colors'>
      Altro
    </button>
  </div>
</div>
