---
const companies = ['Acme Corp', 'Quantum', 'APEX', 'Celestial', 'Echo', 'Pulse', 'Nexus', 'Vertex'];
---

<section class='flex flex-col gap-5 px-container py-container'>
  <p class='text-center text-gray-600 text-lg uppercase font-medium'>Scelto dalle migliori aziende</p>
  <div
    class='group relative overflow-hidden w-full before:content-[""] before:absolute before:top-0 before:bottom-0 before:left-0 before:w-25 before:z-2 before:pointer-events-none before:bg-linear-to-r before:from-white before:to-transparent after:content-[""] after:absolute after:top-0 after:bottom-0 after:right-0 after:w-25 after:z-2 after:pointer-events-none after:bg-linear-to-l after:from-white after:to-transparent'>
    <div class='flex gap-8 animate-[scroll_15s_linear_infinite] group-hover:[animation-play-state:paused]'>
      {
        [...companies, ...companies].map((company) => (
          <div class='shrink-0 flex items-center justify-center px-8 py-6 bg-white border border-gray-200 rounded-lg min-w-37.5'>
            <span class='text-xl font-semibold text-gray-500 whitespace-nowrap'>{company}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
