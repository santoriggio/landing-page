---
import Button from '../button.astro';
import { site } from '../../config';

const slots = site.availableSlots;
const soldOut = slots <= 0;
const availability = soldOut
  ? "Posti esauriti, lista d'attesa aperta"
  : slots === 1
    ? 'Solo 1 posto disponibile'
    : `Solo ${slots} posti disponibili`;
---

<section class="section-hero">
  <img
    class="hero-bg-desktop"
    src="/hero-bg-desktop.png"
    alt=""
    width="2880"
    height="1440"
    aria-hidden="true"
    fetchpriority="high"
    loading="eager"
  />
  <div class="page-wrap hero-layout">
    <div class="hero-copy">
      <p class="pill text-small text-brand-700">
        <span class:list={['pill-dot', { 'is-waitlist': soldOut }]} aria-hidden="true"></span>
        {availability}
      </p>
      <h1 class="text-display text-ink-900">La tua app iOS e Android, ad abbonamento. Disdici quando vuoi.</h1>
      <p class="text-body-l text-ink-500">
        Sviluppo app in React Native per startup e PMI. Una fattura al mese, niente contratti da 25 pagine, niente 8 ore fisse.
      </p>
      <div class="hero-actions">
        <Button variant="primary" href={site.bookingUrl}>Prenota una call</Button>
        <Button variant="secondary" href="#come-funziona" icon={false}>Come funziona</Button>
      </div>
      <p class="hero-trust text-small text-ink-500">Si parte in 14 giorni · 7 giorni di prova</p>
    </div>
  </div>
  <img
    class="hero-bg-mobile"
    src="/hero-bg-mobile.png"
    alt=""
    width="1170"
    height="1260"
    aria-hidden="true"
    loading="eager"
  />
</section>
