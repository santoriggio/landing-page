---
import '../global.css';
import Nav from './nav.astro';
import Footer from './footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'App iOS e Android in abbonamento',
  description = 'Sviluppo app in React Native per startup e PMI. Una fattura al mese, niente contratti da 25 pagine, niente 8 ore fisse.',
  noindex = false,
} = Astro.props;

const fullTitle = `Santo Riggio — ${title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = 'https://www.santoriggio.it/og-image.png';
const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Santo Riggio" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Santo Riggio — App iOS e Android in abbonamento" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="preload" href="/fonts/plus-jakarta-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-800.woff2" as="font" type="font/woff2" crossorigin />
    <!--
      Privacy-friendly analytics (Plausible or Umami). Leave PUBLIC_ANALYTICS_SRC unset.
      Plausible also reads PUBLIC_ANALYTICS_DOMAIN. Umami also reads PUBLIC_ANALYTICS_WEBSITE_ID.
    -->
    {
      analyticsSrc && (
        <script
          is:inline
          defer
          src={analyticsSrc}
          data-domain={import.meta.env.PUBLIC_ANALYTICS_DOMAIN}
          data-website-id={import.meta.env.PUBLIC_ANALYTICS_WEBSITE_ID}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link text-small" href="#contenuto">Vai al contenuto</a>
    <Nav />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
  </body>
</html>
